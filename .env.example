# Personal access
APP_ACCESS_CODE=change-me
ACCESS_COOKIE_SECRET=replace-with-at-least-32-random-characters
MOCK_ACCESS=1

# Web -> API (server-only; use the same secret in both processes)
BACKEND_URL=http://127.0.0.1:4000
BACKEND_SHARED_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL (set MOCK_PERSISTENCE=1 for server-memory local development)
DATABASE_URL=
MOCK_PERSISTENCE=1

# AI (the mock is selected automatically when OPENAI_API_KEY is empty)
OPENAI_API_KEY=
MOCK_AI=1

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=replace-with-at-least-16-random-characters

# Daily reminder metadata
REMINDER_TIMEZONE=America/Bogota
