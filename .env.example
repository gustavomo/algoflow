# Personal access
APP_ACCESS_CODE=change-me
ACCESS_COOKIE_SECRET=replace-with-at-least-32-random-characters
MOCK_ACCESS=1

# Web -> API (server-only; use the same secret in both processes)
BACKEND_URL=http://127.0.0.1:4000
BACKEND_SHARED_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL (set MOCK_PERSISTENCE=1 for server-memory local development)
DATABASE_URL=
MOCK_PERSISTENCE=1

# AI (the mock is selected automatically when OPENAI_API_KEY is empty)
OPENAI_API_KEY=
MOCK_AI=1

# Local API server only. Both CLIs still contact remote model services.
ENABLE_LOCAL_AI_CLI=0
CODEX_CLI_MODELS=gpt-5.5
CODEX_CLI_EFFORTS=low,medium,high,xhigh
CODEX_CLI_DEFAULT_MODEL=gpt-5.5
CODEX_CLI_DEFAULT_EFFORT=medium
CLAUDE_CLI_MODELS=sonnet,opus
CLAUDE_CLI_EFFORTS=low,medium,high,xhigh,max
CLAUDE_CLI_DEFAULT_MODEL=sonnet
CLAUDE_CLI_DEFAULT_EFFORT=medium
AI_CLI_TIMEOUT_MS=45000
AI_CLI_MAX_OUTPUT_BYTES=65536

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=replace-with-at-least-16-random-characters

# Daily reminder metadata
REMINDER_TIMEZONE=America/Bogota
