    "pg": "^8.23.0",
    "pixi.js": "8.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "web-push": "^3.6.7",
    "xstate": "4.38.3"
  },
  "devDependencies": {
    "@mdx-js/loader": "3.0.1",
