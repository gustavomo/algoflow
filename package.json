{
  "name": "algoflow",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @algoflow/web",
    "dev:api": "npm run dev --workspace @algoflow/api",
    "build": "npm run build --workspace @algoflow/api && npm run build --workspace @algoflow/web",
    "start:web": "npm run start --workspace @algoflow/web",
    "start:api": "npm run start --workspace @algoflow/api",
    "lint": "eslint apps packages scripts --ext .ts,.tsx,.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "db:migrate": "npm run db:migrate --workspace @algoflow/api",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test:run && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "8.57.0",
    "eslint-config-next": "^15.5.21",
    "prettier": "3.2.5",
    "typescript": "5.4.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@10.8.2"
}
